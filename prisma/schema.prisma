generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Role {
  id    Int    @id
  name  String @unique
  users User[]

  @@map("roles")
}

model Organization {
  id               Int               @id @default(autoincrement())
  name             String            @unique
  address          String?
  phone            String?
  email            String?
  /// Short code used in enquiry IDs, e.g. "SPA" → SPA-ENQ-00012. Uppercase A–Z / 0–9, 2–6 chars.
  prefix           String?           @unique
  /// Export office (registration) number.
  export_office_no String?
  /// Company logo (PNG / JPG) under uploads/companies/<id>/logo/; shown in the app and on enquiry PDFs.
  logo_path        String?
  created_at       DateTime          @default(now())
  managers         ManagerOrg[]
  accountants      AccountantOrg[]
  documents        CompanyDocument[]
  clients          Client[]
  enquiries        Enquiry[]
  orders           Order[]

  @@map("organizations")
}

model User {
  id                       Int                   @id @default(autoincrement())
  name                     String
  role_id                  Int
  email                    String                @unique
  password                 String
  phone                    String?
  role                     Role                  @relation(fields: [role_id], references: [id])
  managerOrgs              ManagerOrg[]          @relation("ManagerOrganizations")
  accountantOrgs           AccountantOrg[]       @relation("AccountantOrganizations")
  uploadedCompanyDocuments CompanyDocument[]     @relation("CompanyDocumentUploadedBy")
  managerSalesmen          ManagerSalesman[]     @relation("ManagerSalesmen")
  salesmanManager          ManagerSalesman[]     @relation("SalesmanManagers")
  assignedClients          Client[]              @relation("AssignedClients")
  assignedTasks            Task[]                @relation("AssignedTasks")
  createdTasks             Task[]                @relation("CreatedTasks")
  clientLogs               ClientLog[]           @relation("LogAuthor")
  kpiLogs                  SalesmanKpiLog[]      @relation("SalesmanKpi")
  assignedClientTasks      ClientTask[]          @relation("AssignedClientTasks")
  createdClientTasks       ClientTask[]          @relation("CreatedClientTasks")
  createdOrders            Order[]               @relation("OrderCreatedBy")
  updatedShippingRates     ShippingRate[]        @relation("ShippingRateUpdatedBy")
  salesmanTargets          SalesmanTarget[]      @relation("SalesmanTargets")
  assignedTargets          SalesmanTarget[]      @relation("TargetsSetBy")
  createdEnquiries         Enquiry[]             @relation("EnquiryCreatedBy")
  cancelledEnquiries       Enquiry[]             @relation("EnquiryCancelledBy")
  enquiryFollowUps         EnquiryFollowUp[]     @relation("EnquiryFollowUpBy")
  enquiryEvents            EnquiryEvent[]        @relation("EnquiryEventBy")
  recordedPayments         OrderPayment[]        @relation("PaymentRecordedBy")
  taskUpdates              TaskUpdate[]          @relation("TaskUpdateBy")
  uploadedClientDocuments  ClientDocument[]      @relation("ClientDocumentUploadedBy")
  agentRequestsSent        EnquiryAgentRequest[] @relation("EnquiryAgentRequestSentBy")

  @@map("users")
}

model ManagerOrg {
  manager_id Int
  org_id     Int
  manager    User              @relation("ManagerOrganizations", fields: [manager_id], references: [id], onDelete: Cascade)
  org        Organization      @relation(fields: [org_id], references: [id], onDelete: Cascade)
  /// Salesmen working under this manager for this company.
  salesmen   ManagerSalesman[]

  @@id([manager_id, org_id])
  @@index([org_id])
  @@map("manager_org")
}

/// Accountants only see enquiries / orders of clients in the companies they are assigned to.
model AccountantOrg {
  accountant_id Int
  org_id        Int
  accountant    User         @relation("AccountantOrganizations", fields: [accountant_id], references: [id], onDelete: Cascade)
  org           Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)

  @@id([accountant_id, org_id])
  @@index([org_id])
  @@map("accountant_org")
}

/// Company paperwork (CR copy, export license, ...). Files live on local disk under uploads/; `file_path` is relative to it.
/// Files attached to a client (agreements, KYC, trade licence ...). Stored under uploads/clients/<id>/.
model ClientDocument {
  id             Int       @id @default(autoincrement())
  client_id      Int
  description    String
  expiry_date    DateTime? @db.Date
  file_name      String
  file_path      String
  mime_type      String
  size_bytes     Int
  uploaded_by_id Int
  created_at     DateTime  @default(now())
  updated_at     DateTime  @updatedAt
  client         Client    @relation(fields: [client_id], references: [id], onDelete: Cascade)
  uploadedBy     User      @relation("ClientDocumentUploadedBy", fields: [uploaded_by_id], references: [id])

  @@index([client_id])
  @@map("client_documents")
}

model CompanyDocument {
  id             Int          @id @default(autoincrement())
  org_id         Int
  label          String
  doc_number     String?
  expiry_date    DateTime?    @db.Date
  file_name      String
  file_path      String
  mime_type      String
  size_bytes     Int
  uploaded_by_id Int
  created_at     DateTime     @default(now())
  updated_at     DateTime     @updatedAt
  org            Organization @relation(fields: [org_id], references: [id], onDelete: Cascade)
  uploadedBy     User         @relation("CompanyDocumentUploadedBy", fields: [uploaded_by_id], references: [id])

  @@index([org_id])
  @@map("company_documents")
}

/// A salesman works under a manager *for a specific company*: one row per company. A manager can run several
/// companies without every salesman on their team working for all of them. Removing the manager from a
/// company removes that company's rows (cascade through ManagerOrg).
model ManagerSalesman {
  manager_id  Int
  salesman_id Int
  org_id      Int
  manager     User       @relation("ManagerSalesmen", fields: [manager_id], references: [id], onDelete: Cascade)
  salesman    User       @relation("SalesmanManagers", fields: [salesman_id], references: [id], onDelete: Cascade)
  managerOrg  ManagerOrg @relation(fields: [manager_id, org_id], references: [manager_id, org_id], onDelete: Cascade)

  @@id([manager_id, salesman_id, org_id])
  @@index([salesman_id, org_id])
  @@index([org_id])
  @@map("manager_salesman")
}

model Client {
  id                           Int              @id @default(autoincrement())
  name                         String
  contact_person_name          String
  contact_no                   String
  location_coordinates         String?
  mail_id                      String?
  cr_no                        String?          @unique
  cr_expiry_date               DateTime?        @db.Date
  contact_person_designation   String?
  assigned_salesman_id         Int
  org_id                       Int
  notes                        String?
  status                       String
  /// standard | premium (see types/client.ts clientCategories). More categories can be added there.
  category                     String           @default("standard")
  /// Department name when a company is handled per department ("Logistics", "Procurement").
  /// Each department is its own client row with its own salesman, contact, enquiries and orders.
  department                   String?
  /// The company's main client row this department belongs to (null on main rows).
  /// Department rows leave cr_no empty and show the parent's.
  parent_client_id             Int?
  checklist_kyc_verified       Boolean          @default(false)
  checklist_agreement_signed   Boolean          @default(false)
  checklist_rate_card_approved Boolean          @default(false)
  checklist_integration_setup  Boolean          @default(false)
  checklist_dispatch_confirmed Boolean          @default(false)
  checklist_billing_verified   Boolean          @default(false)
  checklist_portal_created     Boolean          @default(false)
  checklist_first_shipment     Boolean          @default(false)
  created_at                   DateTime         @default(now())
  assignedSalesman             User             @relation("AssignedClients", fields: [assigned_salesman_id], references: [id])
  organization                 Organization     @relation(fields: [org_id], references: [id])
  parent                       Client?          @relation("ClientDepartments", fields: [parent_client_id], references: [id])
  departments                  Client[]         @relation("ClientDepartments")
  logs                         ClientLog[]
  clientTasks                  ClientTask[]
  tasks                        Task[]
  orders                       Order[]
  enquiries                    Enquiry[]
  documents                    ClientDocument[]

  @@index([assigned_salesman_id])
  @@index([org_id])
  @@index([org_id, status])
  @@index([assigned_salesman_id, status])
  @@index([status])
  @@index([category])
  @@index([created_at])
  @@index([parent_client_id])
  @@map("clients")
}

model ClientLog {
  id         Int      @id @default(autoincrement())
  client_id  Int
  action     String
  created_at DateTime @default(now())
  done_by    Int
  client     Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  author     User     @relation("LogAuthor", fields: [done_by], references: [id])

  @@index([done_by, created_at])
  @@index([client_id, created_at])
  @@index([created_at])
  @@map("client_logs")
}

model Task {
  id             Int          @id @default(autoincrement())
  assigned_to_id Int
  created_by_id  Int
  description    String
  due_date       DateTime
  notification   Boolean      @default(false)
  status         String
  /// Optional user-chosen type: "order_follow_up" | "payment_follow_up". NULL = general.
  /// Enquiry follow-ups are identified by enquiry_id instead.
  category       String?
  assignedTo     User         @relation("AssignedTasks", fields: [assigned_to_id], references: [id])
  createdBy      User         @relation("CreatedTasks", fields: [created_by_id], references: [id])
  /// Set on automatic follow-up tasks for enquiries left open for 30+ days.
  enquiry_id     Int?
  enquiry        Enquiry?     @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  /// The client a task is about (lead follow-ups). Its outcome updates this client.
  client_id      Int?
  client         Client?      @relation(fields: [client_id], references: [id], onDelete: Cascade)
  /// Lead follow-up result: contacted | follow_up | rejected.
  outcome        String?
  /// When the task was closed (achieved / unsuccessful). Closed tasks are cleaned up after 6 months.
  closed_at      DateTime?
  updates        TaskUpdate[]

  @@index([assigned_to_id, due_date])
  @@index([client_id])
  @@index([status, closed_at])
  @@index([created_by_id])
  @@index([enquiry_id])
  @@map("tasks")
}

/// Activity on a task: outcomes, reasons, due-date changes. Mirrored to client_logs when the task has a client.
model TaskUpdate {
  id            Int       @id @default(autoincrement())
  task_id       Int
  /// contacted | follow_up | rejected | enquiry_follow_up | enquiry_stage | enquiry_closed | status | reassigned
  action        String
  note          String?
  prev_due_date DateTime?
  new_due_date  DateTime?
  created_by_id Int
  created_at    DateTime  @default(now())
  task          Task      @relation(fields: [task_id], references: [id], onDelete: Cascade)
  createdBy     User      @relation("TaskUpdateBy", fields: [created_by_id], references: [id])

  @@index([task_id, created_at])
  @@map("task_updates")
}

model SalesmanKpiLog {
  id          Int    @id @default(autoincrement())
  salesman_id Int
  action      String
  salesman    User   @relation("SalesmanKpi", fields: [salesman_id], references: [id], onDelete: Cascade)

  @@map("salesman_kpi_logs")
}

model ClientTask {
  id             Int      @id @default(autoincrement())
  client_id      Int
  assigned_to_id Int
  created_by_id  Int
  description    String
  due_date       DateTime
  status         String
  client         Client   @relation(fields: [client_id], references: [id], onDelete: Cascade)
  assignedTo     User     @relation("AssignedClientTasks", fields: [assigned_to_id], references: [id], onDelete: Cascade)
  createdBy      User     @relation("CreatedClientTasks", fields: [created_by_id], references: [id], onDelete: Cascade)

  @@index([client_id, due_date])
  @@index([assigned_to_id])
  @@index([created_by_id])
  @@map("client_tasks")
}

model Order {
  id                Int            @id @default(autoincrement())
  client_id         Int
  /// The company the order is under: its enquiry's company, else the client's.
  org_id            Int
  mode              String
  description       String
  payment_mode      String
  amount            Decimal        @default(0) @db.Decimal(12, 2)
  advance_amount    Decimal        @default(0) @db.Decimal(12, 2)
  /// advance_amount + sum(payments). Denormalised for filtering/aggregation; maintained by syncOrderPayments().
  paid_total        Decimal        @default(0) @db.Decimal(12, 2)
  from              String
  to                String
  /// transit | delivered | completed | revision_requested | cancelled (see types/order.ts)
  status            String         @default("transit")
  /// Reason given when the order was cancelled or sent back for revision.
  closed_reason     String?
  /// Retired: the status flow replaced manager / accounts approval. Kept for history.
  accounts_approval String         @default("pending")
  manager_approval  String         @default("pending")
  created_by_id     Int
  /// The enquiry this order currently fulfils. Cleared when the order is sent back for revision.
  enquiry_id        Int?           @unique
  /// The enquiry the order was created from; kept after a revision request for history.
  origin_enquiry_id Int?
  job_no            String?        @unique
  invoice_date      DateTime?      @db.Date
  /// Payment due date; set on conversion (invoice date + credit days for credit orders).
  due_date          DateTime?      @db.Date
  created_at        DateTime       @default(now())
  updated_at        DateTime       @updatedAt
  client            Client         @relation(fields: [client_id], references: [id], onDelete: Cascade)
  organization      Organization   @relation(fields: [org_id], references: [id])
  createdBy         User           @relation("OrderCreatedBy", fields: [created_by_id], references: [id])
  enquiry           Enquiry?       @relation(fields: [enquiry_id], references: [id], onDelete: SetNull)
  payments          OrderPayment[]

  @@index([client_id])
  @@index([org_id])
  @@index([created_by_id])
  @@index([status])
  @@index([created_at])
  @@index([origin_enquiry_id])
  @@index([created_by_id, created_at])
  @@map("orders")
}

model ShippingRate {
  id            Int      @id @default(autoincrement())
  location      String
  port          String
  carrier       String?
  mode          String
  container     String
  price         Decimal  @default(0) @db.Decimal(12, 2)
  currency      String?  @default("USD")
  updated_by_id Int
  created_at    DateTime @default(now())
  updated_at    DateTime @updatedAt
  updatedBy     User     @relation("ShippingRateUpdatedBy", fields: [updated_by_id], references: [id])

  @@unique([location, port, mode, container])
  @@index([location, port])
  @@map("shipping_rates")
}

/// Payments collected against an order after it is raised (the advance is stored on the order itself).
model OrderPayment {
  id             Int      @id @default(autoincrement())
  order_id       Int
  amount         Decimal  @db.Decimal(12, 2)
  paid_on        DateTime @db.Date
  method         String
  reference      String?
  notes          String?
  recorded_by_id Int
  created_at     DateTime @default(now())
  order          Order    @relation(fields: [order_id], references: [id], onDelete: Cascade)
  recordedBy     User     @relation("PaymentRecordedBy", fields: [recorded_by_id], references: [id])

  @@index([order_id])
  @@index([paid_on])
  @@map("order_payments")
}

model Enquiry {
  id                    Int                   @id @default(autoincrement())
  client_id             Int
  /// The company the enquiry is raised under (its ID prefix, export office, and who sees it). Defaults to the client's.
  org_id                Int
  enquiry_date          DateTime              @db.Date
  mode                  String
  from                  String
  to                    String
  /// Where the cargo is picked up from (pickup / collection address). Optional.
  collection_address    String?
  /// Job reference / job type code (e.g. SEFL = Sea Export FCL). Null on enquiries raised before it was added.
  job_ref               String?
  /// Incoterms 2020 rule (EXW, FCA, FOB, CFR, CIF, CPT, CIP, DAP, DPU, DDP). Null on enquiries raised before it was added.
  incoterm              String?
  payment_mode          String
  /// Only when payment_mode is "credit".
  credit_days           Int?
  clearance             Boolean               @default(false)
  /// Dangerous goods.
  is_dg                 Boolean               @default(false)
  /// Only when is_dg: UN number(s), normalised "UN1203" or "UN1203, UN1950".
  un_number             String?
  /// Packing list: [{ length, width, height, qty }] per line, in dimension_unit (see lib/freight.ts). Null = none given.
  packages              Json?
  /// cm | m | ft | in — unit of the package dimensions.
  dimension_unit        String?
  /// Actual gross weight, always stored in kg (converted on save).
  actual_weight         Decimal?              @db.Decimal(12, 3)
  /// Unit the weight was entered in: kg | lb. Null = kg (enquiries raised before it was added).
  weight_unit           String?
  /// true = stackable, false = non-stackable, null = not specified (enquiries raised before it was added).
  stackable             Boolean?
  /// Chargeable weight in kg: the higher of actual and volumetric weight (computed on save, lib/freight.ts).
  chargeable_weight     Decimal?              @db.Decimal(12, 3)
  /// Total volume in cubic metres, computed from the packing list on save.
  cbm                   Decimal?              @db.Decimal(12, 3)
  /// Sea only: 20dc | 40dc | 40hc | 20ot | 40ot | 20fr | 40fr | 20rf | 40rf | lcl | ro_ro | break_bulk (see types/enquiry.ts).
  service_type          String?
  /// Sea reefer (20rf / 40rf) only: set temperature in °C.
  reefer_temp           Decimal?              @db.Decimal(4, 1)
  /// Sea open top (20ot / 40ot) only: ig (in gauge) | og (out of gauge).
  gauge                 String?
  /// Land only: FTL truck type or "ltl" (see types/enquiry.ts).
  truck_type            String?
  /// Null until the enquiry is quoted.
  provisional_cost      Decimal?              @db.Decimal(12, 2)
  provisional_profit    Decimal?              @db.Decimal(12, 2)
  /// Filled by accounts on the order.
  actual_cost           Decimal?              @db.Decimal(12, 2)
  actual_profit         Decimal?              @db.Decimal(12, 2)
  notes                 String?
  /// sent_to_client | inquiry_received | with_agent | quoted | negotiation | offer_revised | confirmed | lost (see types/enquiry.ts).
  status                String                @default("inquiry_received")
  /// "Send to client": secret token of the public fillable form link (/enquiry-form/<token>).
  client_form_token     String?               @unique
  /// Email the form link was sent to, and when.
  client_form_email     String?
  client_form_sent_at   DateTime?
  /// Filled in by the client when they submit the form: their typed name and drawn signature (PNG under uploads/enquiries/<id>/).
  client_signed_name    String?
  client_signed_at      DateTime?
  client_signature_path String?
  /// Required when status is "lost".
  cancel_reason         String?
  cancelled_at          DateTime?
  cancelled_by_id       Int?
  /// When the next automatic follow-up task is due. Null = enquiry_date + 30 days.
  next_follow_up_at     DateTime?             @db.Date
  created_by_id         Int
  created_at            DateTime              @default(now())
  updated_at            DateTime              @updatedAt
  client                Client                @relation(fields: [client_id], references: [id], onDelete: Cascade)
  organization          Organization          @relation(fields: [org_id], references: [id])
  createdBy             User                  @relation("EnquiryCreatedBy", fields: [created_by_id], references: [id])
  cancelledBy           User?                 @relation("EnquiryCancelledBy", fields: [cancelled_by_id], references: [id])
  order                 Order?
  followUps             EnquiryFollowUp[]
  followUpTasks         Task[]
  events                EnquiryEvent[]
  agentRequests         EnquiryAgentRequest[]

  @@index([org_id])
  @@index([client_id])
  @@index([created_by_id])
  @@index([status])
  @@index([created_by_id, status])
  @@index([enquiry_date, id])
  @@map("enquiries")
}

/// Comment logged by the salesman each time they follow up on an open enquiry.
/// Stage history of an enquiry: every status change, with the quoted figures it replaced.
model EnquiryEvent {
  id            Int      @id @default(autoincrement())
  enquiry_id    Int
  /// quoted | negotiation | offer_revised | confirmed | lost | revision_requested | order_cancelled
  action        String
  from_status   String?
  to_status     String?
  /// Figures before this change (offer revised keeps the old quote here).
  prev_cost     Decimal? @db.Decimal(12, 2)
  prev_profit   Decimal? @db.Decimal(12, 2)
  /// Figures after this change.
  cost          Decimal? @db.Decimal(12, 2)
  profit        Decimal? @db.Decimal(12, 2)
  note          String?
  order_id      Int?
  created_by_id Int
  created_at    DateTime @default(now())
  enquiry       Enquiry  @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  createdBy     User     @relation("EnquiryEventBy", fields: [created_by_id], references: [id])

  @@index([enquiry_id, created_at])
  @@map("enquiry_events")
}

model EnquiryFollowUp {
  id            Int      @id @default(autoincrement())
  enquiry_id    Int
  comment       String
  created_by_id Int
  created_at    DateTime @default(now())
  enquiry       Enquiry  @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  createdBy     User     @relation("EnquiryFollowUpBy", fields: [created_by_id], references: [id])

  @@index([enquiry_id, created_at])
  @@map("enquiry_follow_ups")
}

model SalesmanTarget {
  id           Int       @id @default(autoincrement())
  salesman_id  Int
  set_by_id    Int
  amount       Decimal   @db.Decimal(12, 2)
  period_start DateTime  @db.Date
  period_end   DateTime  @db.Date
  /// Set when a manager replaces this target before its period ends.
  closed_at    DateTime?
  created_at   DateTime  @default(now())
  salesman     User      @relation("SalesmanTargets", fields: [salesman_id], references: [id], onDelete: Cascade)
  setBy        User      @relation("TargetsSetBy", fields: [set_by_id], references: [id])

  @@index([salesman_id, period_start])
  @@map("salesman_targets")
}

/// Freight agents (overseas partners, carriers) the team asks for rates with "Send to agent".
model Agent {
  id             Int                   @id @default(autoincrement())
  name           String
  contact_person String?
  email          String
  phone          String?
  created_at     DateTime              @default(now())
  requests       EnquiryAgentRequest[]

  @@map("agents")
}

/// One "Send to agent" rate request: the agent gets an emailed link (/agent-quote/<token>) to give their cost.
model EnquiryAgentRequest {
  id         Int       @id @default(autoincrement())
  enquiry_id Int
  agent_id   Int
  /// Secret token of the agent's link.
  token      String    @unique
  sent_by_id Int
  sent_at    DateTime  @default(now())
  /// The agent's reply: their cost and any terms (validity, transit time…).
  cost       Decimal?  @db.Decimal(12, 2)
  notes      String?
  replied_at DateTime?
  enquiry    Enquiry   @relation(fields: [enquiry_id], references: [id], onDelete: Cascade)
  agent      Agent     @relation(fields: [agent_id], references: [id])
  sentBy     User      @relation("EnquiryAgentRequestSentBy", fields: [sent_by_id], references: [id])

  @@index([enquiry_id])
  @@index([agent_id])
  @@map("enquiry_agent_requests")
}
